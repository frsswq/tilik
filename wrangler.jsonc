{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tilik",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Only the API reaches the Worker script. A page request stays a static
    // asset serve, so it is not billed. See docs/D1-RESULTS.md section 7.
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tilik-results",
      "database_id": "8fc1d261-c5c2-478a-83e8-cbea80e0936a",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": {
    // Daily retention sweep. See docs/D1-RESULTS.md section 11.
    "crons": ["23 4 * * *"],
  },
  "routes": [{ "pattern": "tilik.farissaifuddin.com", "custom_domain": true }],
}
