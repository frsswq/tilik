{
  "name": "personality-test",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:scoring-key && react-router build",
    "build:icons": "bun run scripts/build-icons.ts",
    "build:scoring-key": "bun run scripts/build-scoring-key.ts",
    "check": "ultracite check",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "bun run build && bun run db:migrate && wrangler deploy",
    "dev": "react-router dev",
    "fix": "ultracite fix",
    "import:ipip-16pf": "bun run scripts/import-ipip-16pf.ts",
    "import:ipip-bffm-50": "bun run scripts/import-ipip-bffm-50.ts",
    "import:ipip-neo-120": "bun run scripts/import-ipip-neo-120.ts",
    "import:screening": "bun run scripts/import-screening.ts",
    "prepare": "husky",
    "test": "vitest run",
    "test:e2e": "bun run build && playwright test",
    "test:e2e:built": "playwright test",
    "test:watch": "vitest",
    "typecheck": "wrangler types && react-router typegen && tsc"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@react-router/node": "^8.4.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@react-router/dev": "^8.4.0",
    "@shadcn/lint": "^0.2.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "ultracite": "8.0.0",
    "vite": "^8.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
